{
  "name": "lab-27-langgraph-skills",
  "version": "1.0.0",
  "description": "LangGraph workflow with two createAgent nodes that load skills via createSkillsMiddleware",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch src --watch skills --ext ts,md --exec \"npm run build && node dist/index.js\"",
    "start": "npm run build && node dist/index.js",
    "agent": "npm run build && node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/openrouter": "^0.4.5",
    "deepagents": "^1.11.0",
    "dotenv": "^17.2.3",
    "langchain": "^1.5.0",
    "winston": "^3.19.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
