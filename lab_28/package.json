{
  "name": "lab-28-langchain-skill-npm-deprecated",
  "version": "1.0.0",
  "description": "LangChain ReAct agent with an npm-deprecation skill implemented as a LangChain tool",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && node dist/index.js\"",
    "start": "npm run build && node dist/index.js",
    "agent": "npm run build && node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/openrouter": "^0.4.5",
    "dotenv": "^17.2.3",
    "winston": "^3.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "nodemon": "^3.1.10",
    "typescript": "^5.9.2"
  }
}
