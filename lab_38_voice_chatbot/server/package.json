    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
